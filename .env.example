# SportsVision AI — Environment Variables
# Copy this to .env and fill in your values

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database (SQLite — path relative to project root)
DATABASE_URL=sqlite:///./sportsvision.db

# Storage paths
STORAGE_DIR=./storage
VIDEOS_DIR=./storage/videos
PROCESSED_DIR=./storage/processed
FRAMES_DIR=./storage/frames

# AI Engine
YOLO_MODEL=yolov8n.pt
DETECTION_CONF=0.20
DETECTION_IOU=0.45
# Classes: 0=person, 32=sports ball
DETECTION_CLASSES=0,32

# Processing
FRAME_SKIP=1
# 0 = process every frame, 1 = every other frame, ...
MAX_FRAMES_BUFFER=30

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# MJPEG Streaming
MJPEG_QUALITY=80
STREAM_FPS_LIMIT=25
